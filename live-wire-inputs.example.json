{
  "schema": "emulebb-build-tests.live-wire-inputs.v2",
  "bandwidth": {
    "upload_limit_kibps": 8
  },
  "mfc_profile": {
    "profile_dir": "%EMULEBB_MFC_SOAK_PROFILE_DIR%"
  },
  "rust_profile": {
    "profile_dir": "%EMULEBB_RUST_SOAK_PROFILE_DIR%"
  },
  "soak_storage": {
    "schema": "emulebb-build-tests.soak-storage-policy.v9",
    "max_total_bytes": 34359738368,
    "max_age_seconds": 604800,
    "minimum_free_bytes": 21474836480,
    "bundle_interval_seconds": 3600,
    "rust_diagnostics": {
      "max_segment_bytes": 67108864,
      "max_segment_seconds": 3600,
      "retained_segments": 128,
      "max_total_bytes": 8589934592,
      "max_retained_seconds": 604800,
      "minimum_free_bytes": 21474836480
    },
    "streams": {
      "controller_output": {
        "max_segment_bytes": 8388608,
        "retained_segments": 4
      },
      "daemon_output": {
        "max_segment_bytes": 67108864,
        "retained_segments": 8
      },
      "diagnostic_bundles": {
        "max_segment_bytes": 4194304,
        "retained_segments": 48
      },
      "diagnostic_indexes": {
        "max_segment_bytes": 8388608,
        "retained_segments": 1
      },
      "diagnostic_pins": {
        "max_segment_bytes": 67108864,
        "retained_segments": 4
      },
      "diagnostic_segments": {
        "max_segment_bytes": 67108864,
        "retained_segments": 4
      },
      "observer_actions": {
        "max_segment_bytes": 8388608,
        "retained_segments": 128
      },
      "observer_checkpoints": {
        "max_segment_bytes": 4194304,
        "retained_segments": 288
      },
      "observer_summary": {
        "max_segment_bytes": 8388608,
        "retained_segments": 1
      },
      "preflight_archive_manifest": {
        "max_segment_bytes": 1048576,
        "retained_segments": 1
      },
      "preflight_mfc_outputs": {
        "max_segment_bytes": 67174400,
        "retained_segments": 16
      },
      "preflight_rust_outputs": {
        "max_segment_bytes": 67108864,
        "retained_segments": 1
      },
      "process_metrics": {
        "max_segment_bytes": 8388608,
        "retained_segments": 8
      },
      "process_metrics_summary": {
        "max_segment_bytes": 1048576,
        "retained_segments": 1
      }
    }
  },
  "search_terms": {
    "generic_open": [
      "linux",
      "ubuntu",
      "fedora",
      "freebsd",
      "debian",
      "emule"
    ],
    "documents": [
      "linux",
      "ubuntu",
      "debian",
      "python"
    ],
    "radarr_movies": [
      "Example Public Movie Title"
    ],
    "sonarr_series": [
      "Example Public Series Title"
    ]
  },
  "auto_browse": {
    "bootstrap_transfer_hashes": [
      "0123456789abcdef0123456789abcdef"
    ],
    "direct_bootstrap_transfers": [
      {
        "hash": "0123456789abcdef0123456789abcdef",
        "name": "example-live-bootstrap.iso",
        "size": 1048576,
        "method": "direct_ed2k"
      }
    ]
  },
  "media_corpus": {
    "video_roots": [
      "C:\\example\\public-video-corpus"
    ]
  },
  "shared_directories": {
    "shareddir_file": "%EMULEBB_MFC_SOAK_PROFILE_DIR%\\config\\shareddir.dat",
    "roots": [
      {
        "path": "C:\\example\\fallback-shared-root",
        "recursive": true
      }
    ]
  },
  "native_parity": {
    "ed2k_links_file": "live-wire.local.ed2k-links-fixtures.txt",
    "shared_paths_file": "live-wire.local.ed2k-paths-fixtures.txt",
    "capture_interface": "auto",
    "forbidden_roots": [
      "C:\\example\\retired-client-binaries",
      "C:\\example\\retired-client-incoming"
    ]
  },
  "local_package_install": {
    "target_path": "%EMULEBB_LOCAL_INSTALL_PATH%",
    "import_profile_dir": "%EMULEBB_LOCAL_TEST_PROFILE_PATH%",
    "lan_bind_address": "192.0.2.10",
    "emulebb_port": 4711,
    "p2p_bind_interface": "hide.me",
    "dependency_manifest": "C:\\example\\emulebb-suite-dependencies.json",
    "enable_rest": true,
    "enable_crash_dumps": true
  }
}
